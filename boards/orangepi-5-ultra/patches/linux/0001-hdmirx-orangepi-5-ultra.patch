arm64: dts: rockchip: enable HDMI-RX on Orange Pi 5 Ultra

The board has an HDMI 2.0 input wired to the SoC HDMI receiver, but no
mainline DT enables it.  The controller and its 160 MiB CMA pool are already
described in rk3588-extra.dtsi, and the hdmim2_rx_* pin groups already exist
in rk3588-base-pinctrl.dtsi, so the board only has to flip both nodes to okay
and describe the 5V detect pin.

Pin bank and HPD gpio follow the vendor BSP DT for this board, which uses
hdmim2_rx_* and gpio3 RK_PD3 for hdmirx detect.

Not yet submitted upstream: needs a capture test on hardware first.

--- a/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-ultra.dts	2026-08-23 22:08:57.043880946 +0900
+++ b/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-ultra.dts	2026-08-23 22:09:31.351555764 +0900
@@ -48,6 +48,18 @@
 	status = "okay";
 };
 
+&hdmi_receiver_cma {
+	status = "okay";
+};
+
+&hdmi_receiver {
+	hpd-gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&hdmim2_rx_cec &hdmim2_rx_hpdin &hdmim2_rx_scl
+		     &hdmim2_rx_sda &hdmirx_hpd>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
 &hdptxphy1 {
 	status = "okay";
 };
@@ -71,6 +83,12 @@
 		};
 	};
 
+	hdmirx {
+		hdmirx_hpd: hdmirx-5v-detection {
+			rockchip,pins = <3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
 	usb {
 		usb_otg_pwren: usb-otg-pwren {
 			rockchip,pins = <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
