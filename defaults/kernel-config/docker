# Kernel config docker/containerd/runc need, from app-containers/docker's CONFIG_CHECK.

# Namespaces. USER_NS is the only one not already on.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# Cgroup controllers docker needs.
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Keyrings and /dev/mqueue for containers.
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
# Seccomp profile support.
CONFIG_SECCOMP_FILTER=y

# Bridge/veth/macvlan/vxlan for container networking.
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VXLAN=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_DUMMY=m

# Netfilter core, off by default.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_NAT=m
CONFIG_BRIDGE_NETFILTER=m

# Legacy iptables chain, required by the docker ebuild's CONFIG_CHECK.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m

# IPVS, for swarm-mode load balancing.
CONFIG_IP_VS=m
CONFIG_IP_VS_NFCT=y

# IPsec for the encrypted overlay network driver.
CONFIG_XFRM_USER=m
CONFIG_INET_ESP=m
CONFIG_CRYPTO_GCM=m
CONFIG_CRYPTO_SEQIV=m

# overlay2 storage driver.
CONFIG_OVERLAY_FS=m

# ACL/security xattrs for ext4, which containers need.
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
